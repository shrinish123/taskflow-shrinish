# Database
DB_USER=taskflow
DB_PASSWORD=taskflow_secret
DB_NAME=taskflow

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string-in-production

# Server
PORT=8080

# CORS (comma-separated origins, defaults to * for API-only mode)
# CORS_ORIGINS=http://localhost:3000

# Seeding (set to "true" to seed test data on first startup)
SEED_DB=true
